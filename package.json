{
  "name": "prompthub-dsh-ecosystem",
  "version": "0.1.1",
  "description": "PromptHub Plugin and Skill catalog for DeepSeek Harness",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loiasdi/dsh-prompthub-ecosystem.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "pack:local": "./scripts/build-package.sh"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "UNLICENSED"
}
